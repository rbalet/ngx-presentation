{
  "name": "ngx-presentation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "portless run ng serve --host 127.0.0.1",
    "build": "ng build",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "playwright test",
    "check:i18n": "node .agents/skills/ngx-translate/scripts/check.mjs audit --root src/i18n --source en.json --target de.json --target fr.json"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@codemirror/lang-angular": "^0.1.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "@ngx-formly/core": "^11.2.0",
    "@ngx-translate/core": "^18.1.0",
    "codemirror": "^6.0.2",
    "jsonc-parser": "^3.3.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "portless": "0.17.0",
    "typescript": "~6.0.3"
  }
